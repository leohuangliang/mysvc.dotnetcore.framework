<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>MySvc.Framework.Infrastructure.Serilog</id>
    <version>$(CurrentVersion)</version>
    <title>$(PackageTitle)</title>
    <authors>$(PackageAuthors)</authors>
    <owners>$(PackageOwners)</owners>
    <requireLicenseAcceptance>$(PackageRequireLicenseAcceptance)</requireLicenseAcceptance>
    <description>Serilog日志记录</description>
    <releaseNotes>$(PackageReleaseNotes)</releaseNotes>
    <copyright>$(PackageCopyright)</copyright>
    <tags>$(PackageTags)</tags>
    <serviceable>$(PackageServiceable)</serviceable>
    <dependencies>
      <group targetFramework="net8.0">
        <dependency id="Serilog" version="$(SerilogVersion)" />
        <dependency id="Serilog.Sinks.PeriodicBatching" version="$(SerilogSinksPeriodicBatchingVersion)" />
        <dependency id="MailKit" version="$(MailKitVersion)" />
        <dependency id="System.Text.RegularExpressions" version="$(SystemTextRegularExpressionsVersion)" />
        <dependency id="MySvc.Framework.Infrastructure.Crosscutting" version="$(CurrentVersion)" />
      </group>
    </dependencies>
  </metadata>
  <files>
    <file src="..\..\Infrastructure.Logging.Serilog\bin\Release\net8.0\MySvc.Framework.Infrastructure.Serilog.dll" target="lib\net8.0\MySvc.Framework.Infrastructure.Serilog.dll" />
    <file src="..\..\Infrastructure.Logging.Serilog\bin\Release\net8.0\MySvc.Framework.Infrastructure.Serilog.pdb" target="lib\net8.0\MySvc.Framework.Infrastructure.Serilog.pdb" />
  </files>
</package>