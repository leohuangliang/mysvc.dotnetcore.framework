<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>MySvc.Framework.Domain.Core</id>
    <version>$(CurrentVersion)</version>
    <title>$(PackageTitle)</title>
    <authors>$(PackageAuthors)</authors>
    <owners>$(PackageOwners)</owners>
    <requireLicenseAcceptance>$(PackageRequireLicenseAcceptance)</requireLicenseAcceptance>
    <description>领域模型相关基础实现</description>
    <releaseNotes>$(PackageReleaseNotes)</releaseNotes>
    <copyright>$(PackageCopyright)</copyright>
    <tags>$(PackageTags)</tags>
    <serviceable>$(PackageServiceable)</serviceable>
    <dependencies>
      <group targetFramework="net8.0">
        <dependency id="MediatR" version="$(MediatRVersion)" />
        <dependency id="MySvc.Framework.Infrastructure.Crosscutting" version="$(CurrentVersion)" />
      </group>
    </dependencies>
  </metadata>
  <files>
    <file src="..\..\Domain.Core\bin\Release\net8.0\MySvc.Framework.Domain.Core.dll" target="lib\net8.0\MySvc.Framework.Domain.Core.dll" />
    <file src="..\..\Domain.Core\bin\Release\net8.0\MySvc.Framework.Domain.Core.pdb" target="lib\net8.0\MySvc.Framework.Domain.Core.pdb" />
  </files>
</package>