<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>MySvc.Framework.Infrastructure.Adapter.AutoMapper</id>
    <version>$(CurrentVersion)</version>
    <title>$(PackageTitle)</title>
    <authors>$(PackageAuthors)</authors>
    <owners>$(PackageOwners)</owners>
    <requireLicenseAcceptance>$(PackageRequireLicenseAcceptance)</requireLicenseAcceptance>
    <description>基于AutoMapper实现适配器</description>
    <releaseNotes>$(PackageReleaseNotes)</releaseNotes>
    <copyright>$(PackageCopyright)</copyright>
    <tags>$(PackageTags)</tags>
    <serviceable>$(PackageServiceable)</serviceable>
    <dependencies>
      <group targetFramework="net8.0">
        <dependency id="AutoMapper" version="$(AutoMapperVersion)" />
        <dependency id="MySvc.Framework.Infrastructure.Crosscutting" version="$(CurrentVersion)" />
      </group>
    </dependencies>
  </metadata>
  <files>
    <file src="..\..\Infrastructure.Adapter.AutoMapper\bin\Release\net8.0\MySvc.Framework.Infrastructure.AutoMapper.dll" target="lib\net8.0\MySvc.Framework.Infrastructure.AutoMapper.dll" />
    <file src="..\..\Infrastructure.Adapter.AutoMapper\bin\Release\net8.0\MySvc.Framework.Infrastructure.AutoMapper.pdb" target="lib\net8.0\MySvc.Framework.Infrastructure.AutoMapper.pdb" />
  </files>
</package>