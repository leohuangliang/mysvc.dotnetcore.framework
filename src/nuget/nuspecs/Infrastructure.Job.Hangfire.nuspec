  <metadata>
    <id>MySvc.Framework.Infrastructure.Job.Hangfire</id>
    <version>$(CurrentVersion)</version>
    <title>$(PackageTitle)</title>
    <authors>$(PackageAuthors)</authors>
    <owners>$(PackageOwners)</owners>
    <requireLicenseAcceptance>$(PackageRequireLicenseAcceptance)</requireLicenseAcceptance>
    <description>基于Hangfire 实现job</description>
    <releaseNotes>$(PackageReleaseNotes)</releaseNotes>
    <copyright>$(PackageCopyright)</copyright>
    <tags>$(PackageTags)</tags>
    <dependencies>
      <group targetFramework="net8.0">
        <dependency id="Hangfire.Core" version="$(HangfireCoreVersion)" />
        <dependency id="MySvc.Framework.Infrastructure.Crosscutting" version="$(CurrentVersion)" />
      </group>
    </dependencies>
  </metadata>
  <files>
    <file src="..\..\Infrastructure.Job.Hangfire\bin\Release\net8.0\MySvc.Framework.Infrastructure.Job.Hangfire.dll" target="lib\net8.0\MySvc.Framework.Infrastructure.Job.Hangfire.dll" />
